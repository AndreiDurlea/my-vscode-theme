{
  "name": "deutherium",
  "displayName": "Deuterium",
  "description": "Dark high-contrast themes modeled after JetBrains IDE color schemes, featuring Deuterium and Deuterium Lite.",
  "version": "1.1.3",
  "icon": "images/icon.png",
  "publisher": "andreidurlea",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreiDurlea/my-vscode-theme.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Deuterium",
        "uiTheme": "vs-dark",
        "path": "./themes/deuterium-color-theme.json"
      },
      {
        "label": "Deuterium Lite",
        "uiTheme": "vs-dark",
        "path": "./themes/deuterium-lite-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Consolas, Menlo, Monaco, 'Courier New', monospace",
      "editor.bracketPairColorization.enabled": false
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.19.0"
  }
}
